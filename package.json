{
  "name": "artifactkit",
  "version": "0.1.0",
  "description": "A UI kit for AI agents that write HTML. Self-contained single-file reports, dashboards, kanbans, wikis, scorecards and decks that work offline, print properly and carry no credentials.",
  "keywords": [
    "agent", "ai", "llm", "claude", "copilot", "agent-skills",
    "html", "single-file", "offline", "dashboard", "report",
    "kanban", "css", "charts", "svg", "print", "no-build"
  ],
  "license": "MIT",
  "type": "module",
  "files": ["src", "scripts", "examples/templates", "examples/swatch.html", ".agents", "README.md", "LICENSE"],
  "bin": {
    "artifactkit-build": "scripts/build.mjs",
    "artifactkit-validate": "scripts/validate.mjs",
    "artifactkit-drift": "scripts/drift.mjs"
  },
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "check": "node scripts/check-all.mjs",
    "test": "node scripts/build-all.mjs && node scripts/check-all.mjs"
  },
  "engines": { "node": ">=18" },
  "repository": { "type": "git", "url": "git+https://github.com/OWNER/artifactkit.git" },
  "homepage": "https://github.com/OWNER/artifactkit#readme",
  "bugs": { "url": "https://github.com/OWNER/artifactkit/issues" }
}
